{
  "name": "@local/dsh-computer-control",
  "version": "1.1.0",
  "description": "Drive the local Windows desktop from DeepSeek Harness: screen capture, template and colour search, OCR, mouse, keyboard, window, clipboard, application, recording, system control, and a browsable log of what the session has done.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "selftest.js",
    "lib",
    "native",
    "locale",
    "icon.svg",
    "README.md"
  ],
  "os": [
    "win32"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "computer-use",
    "windows",
    "screen-capture",
    "ocr",
    "automation"
  ],
  "scripts": {
    "test": "node test/run.mjs",
    "selftest": "node selftest.js"
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
